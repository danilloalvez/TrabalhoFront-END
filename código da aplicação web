import React, { useEffect, useState } from "react";
import { INITIAL_LESSONS } from "../data/lessonsData";
import { Lesson } from "../types/learning";
import { LessonCard } from "../components/LessonCard";
import { StudentStats } from "../components/StudentStats";
import { TopicFilter } from "../components/TopicFilter";
import { useAuth } from "../contexts/AuthContext";

export const DashboardPage: React.FC = () => {
  const { student } = useAuth();
  const [lessons, setLessons] = useState<Lesson[]>(INITIAL_LESSONS);
  const [selectedTopic, setSelectedTopic] = useState<string>("Todas");

  useEffect(() => {
    document.title = "CodeMédio | Dashboard de Estudos";
  }, []);

  const handleToggleComplete = (id: number) => {
    setLessons((prev) =>
      prev.map((item) =>
        item.id === id ? { ...item, completed: !item.completed } : item
      )
    );
  };

  const filteredLessons =
    selectedTopic === "Todas"
      ? lessons
      : lessons.filter((item) => item.topic === selectedTopic);

  const completedCount = lessons.filter((item) => item.completed).length;

  return (
    <section style={{ maxWidth: "1040px", margin: "0 auto", padding: "32px 20px" }}>
      <StudentStats
        studentName={student.name}
        schoolGrade={student.schoolGrade}
        loggedIn={student.loggedIn}
        completedCount={completedCount}
        totalCount={lessons.length}
      />
      <TopicFilter
        topics={["Todas", "Lógica", "Web", "Dados"]}
        selectedTopic={selectedTopic}
        onSelectTopic={setSelectedTopic}
      />
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
          gap: "20px",
        }}
      >
        {filteredLessons.map((lesson) => (
          <LessonCard
            key={lesson.id}
            lesson={lesson}
            onToggleComplete={handleToggleComplete}
          />
        ))}
      </div>
    </section>
  );
};

