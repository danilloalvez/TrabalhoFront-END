import React, { createContext, useContext, useState, ReactNode } from "react";
import { StudentSession } from "../types/learning";

interface AuthContextType {
  student: StudentSession;
  loginStudent: (name: string, schoolGrade: string) => void;
  logoutStudent: () => void;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
  const [student, setStudent] = useState<StudentSession>({
    name: "",
    schoolGrade: "1º Ano do Ensino Médio",
    loggedIn: false,
  });

  const loginStudent = (name: string, schoolGrade: string) => {
    setStudent({
      name: name.trim() || "Estudante",
      schoolGrade,
      loggedIn: true,
    });
  };

  const logoutStudent = () => {
    setStudent({
      name: "",
      schoolGrade: "1º Ano do Ensino Médio",
      loggedIn: false,
    });
  };

  return (
    <AuthContext.Provider value={{ student, loginStudent, logoutStudent }}>
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = (): AuthContextType => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error("useAuth deve ser usado dentro de um AuthProvider");
  }
  return context;
};

